{
  "name": "cskh-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components hooks lib types tests next.config.ts",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-cskh --only auth,firestore,storage \"vitest run tests/firebase.integration.test.ts\"",
    "format": "prettier --write app components hooks lib types tests docs/plans/2026-10-21-nextjs-migration.md *.ts *.mjs package.json firebase.json"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
