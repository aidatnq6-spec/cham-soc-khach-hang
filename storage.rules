rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/issues/{issueId}/{filename} {
      function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.email == 'phongdepdanang@gmail.com'; }
      allow read: if owner();
      allow create: if owner() && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }
  }
}
